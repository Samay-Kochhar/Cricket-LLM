{
   "description": "Schema for single IPL match JSON file (raw unmodified structure).",
    "meta": {
    "data_version": "string",
    "created": "YYYY-MM-DD",
    "revision": "integer"
  },
  "info": {
    "balls_per_over": "integer",
    "city": "string",
    "dates": ["YYYY-MM-DD"],
    "event": {
      "name": "string",
      "match_number": "integer"
    },
    "gender": "string",
    "match_type": "string",                 
    "officials": {
      "match_referees": ["string"],
      "reserve_umpires": ["string"],
      "tv_umpires": ["string"],
      "umpires": ["string"]
    },
    "outcome": {
      "winner": "string",
      "by": {
        "runs": "integer (optional)",
        "wickets": "integer (optional)"
      }
    },
    "overs": "integer",                     
    "player_of_match": ["string"],
    "players": {
      "<Team A>": ["string"],               
      "<Team B>": ["string"]
    },
    "registry": {
      "people": { "Name": "id-string", "...": "..." }  
    },
    "season": "integer or string",          
    "team_type": "string",                  
    "teams": ["string","string"],           
    "toss": {
      "decision": "string",                 
      "winner": "string"
    },
    "venue": "string"
  },
  "innings": [
    {
      "team": "string",                     
      "overs": [
        {
          "over": "integer (0-based over index)",
          "deliveries": [
            {
              "batter": "string",
              "bowler": "string",
              "non_striker": "string",
              "runs": {
                "batter": "integer",
                "extras": "integer",
                "total": "integer"
              },
              "extras": {                   
                "wides": "integer (optional)",
                "noballs": "integer (optional)",
                "byes": "integer (optional)",
                "legbyes": "integer (optional)"
              },
              "wickets": [                  
                {
                  "kind": "string",         
                  "player_out": "string",
                  "fielders": [ { "name": "string" } ]
                }
              ]
            }
          ]
        }
      ],
      "powerplays": [                       
        { "from": "float (e.g., 0.1)", "to": "float (e.g., 5.6)", "type": "string" }
      ],
      "target": {                           
        "overs": "integer",
        "runs": "integer"
      }
    }
  ]
}
