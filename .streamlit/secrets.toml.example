# Copy these values into Streamlit Community Cloud's Secrets panel.
GEMINI_API_KEY = ""
GEMINI_DEFAULT_MODEL = "gemini-2.5-flash"
GEMINI_COMPLEX_MODEL = "gemini-2.5-pro"

