APP_ENV=development
DUCKDB_PATH=/app/data/odi_analytics.duckdb
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=
USE_SEMANTIC_ANALYTICS_V2=true
# Defaults to true in development and false in production.
# SEMANTIC_V2_DEV_FALLBACK=true

# Direct CSV or ZIP download used only when data/odi_bbb-25.csv and the derived
# DuckDB are both missing. Add the verified Himanshu Ganjoo source URL here.
CRICATLAS_DATA_URL=
# Optional SHA-256 of the downloaded CSV/ZIP artifact.
CRICATLAS_DATA_SHA256=
# Required only when a ZIP contains multiple CSV files.
CRICATLAS_DATA_ARCHIVE_MEMBER=odi_bbb-25.csv
