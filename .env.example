APP_ENV=development
DUCKDB_PATH=/app/data/odi_analytics.duckdb
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_COMPLEX_MODEL=gemini-2.5-pro
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=
USE_SEMANTIC_ANALYTICS_V2=true
# Defaults to true in development and false in production.
# SEMANTIC_V2_DEV_FALLBACK=true

# Optional override. When empty, CricAtlas downloads Himanish Ganjoo's published
# ODI CSV automatically if both the local CSV and DuckDB are missing.
CRICATLAS_DATA_URL=
# Optional SHA-256 of the downloaded CSV/ZIP artifact.
CRICATLAS_DATA_SHA256=
# Required only when an override URL points to a ZIP containing multiple CSVs.
CRICATLAS_DATA_ARCHIVE_MEMBER=
